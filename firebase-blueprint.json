{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and settings",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "avatar": { "type": "string", "description": "Base64 encoded avatar image" },
        "phone": { "type": "string" },
        "cpf": { "type": "string" },
        "plan": { "type": "string", "enum": ["FREE", "PRO", "VIP"] },
        "billingCycle": { "type": "string", "enum": ["MONTHLY", "ANNUAL"] },
        "language": { "type": "string", "enum": ["pt-BR", "en-US"] },
        "subscriptionStatus": { "type": "string", "enum": ["ACTIVE", "PENDING", "OVERDUE", "INACTIVE"] },
        "overdraftLimit": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Account opening date" }
      },
      "required": ["name", "email", "plan"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Financial transaction",
      "type": "object",
      "properties": {
        "description": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string", "enum": ["BRL", "USD"] },
        "date": { "type": "string", "format": "date" },
        "type": { "type": "string", "enum": ["Receita", "Despesa"] },
        "category": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["description", "amount", "currency", "date", "type", "userId"]
    },
    "Investment": {
      "title": "Investment",
      "description": "Financial investment",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "initialAmount": { "type": "number" },
        "currentValue": { "type": "number" },
        "yieldRate": { "type": "number" },
        "currency": { "type": "string", "enum": ["BRL", "USD"] },
        "userId": { "type": "string" },
        "goalId": { "type": "string", "description": "Optional linked goal ID" },
        "category": { "type": "string", "description": "Asset category" }
      },
      "required": ["name", "initialAmount", "currentValue", "currency", "userId"]
    },
    "CalendarEvent": {
      "title": "CalendarEvent",
      "description": "Task or reminder",
      "type": "object",
      "properties": {
        "description": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "done": { "type": "boolean" },
        "userId": { "type": "string" }
      },
      "required": ["description", "date", "done", "userId"]
    },
    "CreditCard": {
      "title": "CreditCard",
      "description": "User credit card details",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "limit": { "type": "number" },
        "closingDay": { "type": "integer" },
        "dueDay": { "type": "integer" },
        "currency": { "type": "string", "enum": ["BRL", "USD"] },
        "userId": { "type": "string" }
      },
      "required": ["name", "limit", "closingDay", "dueDay", "currency", "userId"]
    },
    "CreditTransaction": {
      "title": "CreditTransaction",
      "description": "Expense on a credit card or overdraft",
      "type": "object",
      "properties": {
        "cardId": { "type": "string" },
        "description": { "type": "string" },
        "amount": { "type": "number" },
        "installments": { "type": "integer" },
        "totalInstallments": { "type": "integer" },
        "date": { "type": "string", "format": "date" },
        "category": { "type": "string" },
        "userId": { "type": "string" },
        "isOverdraft": { "type": "boolean" }
      },
      "required": ["cardId", "description", "amount", "totalInstallments", "date", "userId"]
    },
    "SystemNotification": {
      "title": "SystemNotification",
      "description": "System notification or direct message from admin",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "message": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "message", "userId", "createdAt"]
    },
    "Goal": {
      "title": "Goal",
      "description": "Financial savings goals and interactive monthly milestones",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "targetAmount": { "type": "number" },
        "currentAmount": { "type": "number" },
        "currency": { "type": "string", "enum": ["BRL", "USD"] },
        "targetMonths": { "type": "number" },
        "startDate": { "type": "string" },
        "deadlineDate": { "type": "string" },
        "distributionType": { "type": "string", "enum": ["EQUAL", "CUSTOM"] },
        "status": { "type": "string", "enum": ["IN_PROGRESS", "COMPLETED"] },
        "userId": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["title", "targetAmount", "currentAmount", "userId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile document"
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Financial transactions collection"
    },
    "/investments/{investmentId}": {
      "schema": "Investment",
      "description": "Financial investments collection"
    },
    "/calendar/{eventId}": {
      "schema": "CalendarEvent",
      "description": "Calendar events collection"
    },
    "/credit_cards/{cardId}": {
      "schema": "CreditCard",
      "description": "User credit cards"
    },
    "/credit_transactions/{txId}": {
      "schema": "CreditTransaction",
      "description": "Credit and overdraft transactions"
    },
    "/ai_conversations/{convId}": {
      "schema": "AiConversation",
      "description": "Persisted AI chat history"
    },
    "/notifications/{notificationId}": {
      "schema": "SystemNotification",
      "description": "Announcements and direct messages from admin"
    },
    "/goals/{goalId}": {
      "schema": "Goal",
      "description": "Financial savings goals and objectives"
    }
  }
}
